      "syntax-variable": "#d8d8d8",
      "syntax-property": "#cfcfcf",
      "syntax-type": "#b8b8b8",
      "syntax-constant": "#e8e8e8",
      "syntax-operator": "#cfcfcf",
      "syntax-punctuation": "#eeeeee",
      "syntax-object": "#d8d8d8",
      "markdown-heading": "#f5f5f5",
      "markdown-text": "#eeeeee",
      "markdown-link": "#e8e8e8",
      "markdown-link-text": "#cfcfcf",
      "markdown-code": "#cfcfcf",
      "markdown-block-quote": "#b8b8b8",
      "markdown-emph": "#b8b8b8",
      "markdown-strong": "#f5f5f5",
      "markdown-horizontal-rule": "#808080",
      "markdown-list-item": "#e8e8e8",
      "markdown-list-enumeration": "#cfcfcf",
      "markdown-image": "#e8e8e8",
      "markdown-image-text": "#cfcfcf",
      "markdown-code-block": "#eeeeee"
    }
