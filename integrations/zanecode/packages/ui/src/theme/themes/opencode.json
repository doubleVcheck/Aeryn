{
  "$schema": "https://github.com/zephyrzane/zanellm/desktop-theme.json",
  "name": "zanecode",
  "id": "opencode",
  "light": {
    "palette": {
      "neutral": "#ffffff",
      "ink": "#1a1a1a",
      "primary": "#1a1a1a",
      "accent": "#4a4a4a",
      "success": "#2f6f46",
      "warning": "#6a5f32",
      "error": "#8f3434",
      "info": "#3f3f3f",
      "diffAdd": "#2f6f46",
      "diffDelete": "#8f3434"
    },
    "overrides": {
      "text-weak": "#8a8a8a",
      "syntax-comment": "#8a8a8a",
      "syntax-keyword": "#1a1a1a",
      "syntax-string": "#4a4a4a",
      "syntax-primitive": "#2f2f2f",
      "syntax-variable": "#3f3f3f",
      "syntax-property": "#4a4a4a",
      "syntax-type": "#5a5a5a",
      "syntax-constant": "#2f2f2f",
      "syntax-operator": "#4a4a4a",
      "syntax-punctuation": "#1a1a1a",
      "syntax-object": "#3f3f3f",
      "markdown-heading": "#1a1a1a",
      "markdown-text": "#1a1a1a",
      "markdown-link": "#2f2f2f",
      "markdown-link-text": "#3f3f3f",
      "markdown-code": "#4a4a4a",
      "markdown-block-quote": "#5a5a5a",
      "markdown-emph": "#5a5a5a",
      "markdown-strong": "#1a1a1a",
      "markdown-horizontal-rule": "#8a8a8a",
      "markdown-list-item": "#2f2f2f",
      "markdown-list-enumeration": "#3f3f3f",
      "markdown-image": "#2f2f2f",
      "markdown-image-text": "#3f3f3f",
      "markdown-code-block": "#1a1a1a"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#0a0a0a",
      "ink": "#eeeeee",
      "primary": "#f5f5f5",
      "accent": "#cfcfcf",
