function unsupportedGemini() {
  console.error(yellow("Gemini CLI does not currently expose a full OpenAI-compatible provider override."));
  console.error("Use zanecodex, zanecc, zaneopencode, or zanehermes for ZaneLLM-backed agent runs.");
  console.error("The normal 'gemini' command is untouched.");
  process.exit(2);
}

function unsupportedCursor() {
  console.error(yellow("Cursor CLI/editor does not expose a complete CLI provider override for the coding agent surface."));
  console.error("The normal Cursor app stays untouched. Use zanecodex, zanecc, zaneopencode, or zanehermes.");
  process.exit(2);
}

function install(args = [], options = {}) {
  const quiet = options.quiet || args.includes("--quiet");
  const configCreated = createDefaultConfigIfNeeded();
  ensureDir(localBinDir);

  const previousState = readJson(stateFile, {});
  const oldBackups = Array.isArray(previousState.backups) ? previousState.backups : [];
  const backups = [...oldBackups];
  const links = [];
  const timestamp = new Date().toISOString().replace(/[-:]/g, "").replace(/\..+$/, "Z");

  for (const command of bridgeCommands) {
    const linkPath = path.join(localBinDir, command);
    const target = __filename;
    let backupPath = "";
    try {
      if (fs.existsSync(linkPath) || fs.lstatSync(linkPath).isSymbolicLink()) {
        const stat = fs.lstatSync(linkPath);
        if (stat.isSymbolicLink()) {
          const currentTarget = path.resolve(path.dirname(linkPath), fs.readlinkSync(linkPath));
          if (currentTarget === target) {
            links.push({ command, path: linkPath, target });
            continue;
          }
        }
        backupPath = `${linkPath}.zane-bridge-backup-${timestamp}`;
        fs.renameSync(linkPath, backupPath);
        backups.push({ command, original: linkPath, backup: backupPath });
      }
    } catch {
      // lstat throws for missing files; that is fine.
    }

    try {
      fs.symlinkSync(target, linkPath);
    } catch (error) {
      fail(`could not create ${linkPath}: ${error.message}`);
    }
    links.push({ command, path: linkPath, target, backupPath });
  }

  writeJson(stateFile, {
    version: "0.1.0",
    packageRoot,
    installedAt: new Date().toISOString(),
    target: __filename,
    configCreated,
    links,
    backups
  });

  if (!quiet) {
    console.log(green("Installed Zane CLI bridge."));
    console.log(`Commands: ${bridgeCommands.map((c) => cyan(c)).join(", ")}`);
    console.log(`Config: ${configFile}`);
    console.log(`Credentials: ${credentialsFile}`);
    console.log(`Restore: ${cyan("zane restore")}`);
  }
}

function restore(args) {
  if (args.includes("--help") || args.includes("-h")) {
    restoreHelp();
    return;
  }

  const purgeConfig = args.includes("--purge-config");
  const removeManager = args.includes("--remove-manager") || args.includes("--all");
  const state = readJson(stateFile, {});
  const knownTarget = state.target || __filename;
  const linkRecords = Array.isArray(state.links)
    ? state.links
    : bridgeCommands.map((command) => ({ command, path: path.join(localBinDir, command), target: knownTarget }));
  let removed = 0;
  let restored = 0;

  for (const record of linkRecords) {
    if (!removeManager && record.command === "zane") continue;
    const linkPath = record.path || path.join(localBinDir, record.command);
    try {
      const stat = fs.lstatSync(linkPath);
      if (stat.isSymbolicLink()) {
        const target = path.resolve(path.dirname(linkPath), fs.readlinkSync(linkPath));
        if (target === knownTarget || target === __filename) {
          fs.unlinkSync(linkPath);
          removed += 1;
        }
      }
    } catch {
      // missing is already restored
    }
  }

  const backups = Array.isArray(state.backups) ? state.backups : [];
  for (const backup of backups.reverse()) {
    if (!removeManager && backup.command === "zane") continue;
    try {
      if (!fs.existsSync(backup.original) && fs.existsSync(backup.backup)) {
        fs.renameSync(backup.backup, backup.original);
        restored += 1;
      }
    } catch {
      // leave backup in place if restore failed
    }
  }

  const remainingLinks = removeManager
    ? []
    : linkRecords.filter((record) => record.command === "zane");
  if (remainingLinks.length > 0) {
    writeJson(stateFile, {
      ...state,
      restoredAt: new Date().toISOString(),
      links: remainingLinks,
      backups: backups.filter((backup) => backup.command === "zane")
    });
  } else {
    try {
      fs.unlinkSync(stateFile);
    } catch {
      // optional
    }
  }

  for (const file of [opencodeConfigFile, continueConfigFile, codexCatalogFile]) {
    try {
      fs.unlinkSync(file);
    } catch {
      // optional
    }
  }
  removeManagedBlock(grokConfigFile, "grok-model");

  if (purgeConfig) {
    for (const target of [configFile]) {
      try {
        fs.unlinkSync(target);
      } catch {
        // optional
      }
    }
    try {
      fs.rmSync(hermesHome, { recursive: true, force: true });
    } catch {
      // optional
    }
  }

  console.log(green("Restored Zane CLI bridge install."));
  console.log(`Removed wrapper links: ${removed}`);
  console.log(`Restored backups: ${restored}`);
  if (!removeManager) {
    console.log(dim("Kept the zane manager command. Run 'zane install' or 'zanei' to recreate wrappers."));
  }
  if (!purgeConfig) {
    console.log(dim(`Kept config and credentials in ${configDir}. Use --purge-config to remove generated config.`));
  }
}

function restoreHelp() {
  console.log("Usage:");
  console.log("  zane restore");
  console.log("  zane restore --remove-manager");
  console.log("  zane restore --purge-config");
  console.log("");
  console.log("Removes Zane wrapper links and restores any command backups made by zane install.");
  console.log("By default, keeps the zane manager command so you can run 'zane install' or 'zanei' again.");
  console.log("Credentials are kept unless you delete them yourself.");
}

function status() {
  const config = loadBridgeConfig();
  console.log(`${cyan("Zane CLI Bridge")} ${dim("0.1.0")}`);
  console.log(`base:       ${config.baseUrl}`);
  console.log(`openai:     ${openAIChatBase(config.baseUrl)}`);
  console.log(`responses:  ${openAIResponsesBase(config.baseUrl)}`);
  console.log(`anthropic:  ${anthropicBase(config.baseUrl)}`);
  console.log(`upstream:   ${config.upstreamBaseUrl}`);
  console.log(`model:      ${config.model}`);
  console.log(`reasoning:  ${config.reasoning}`);
  console.log(`key:        ${config.keyPresent ? green("present") : red("missing")}`);
  console.log(`auth token: ${config.artemisiaAccessToken ? green("present") : dim("not stored")}`);
  console.log(`account id: ${config.newApiUserId || dim("auto")}`);
  console.log(`providers:  ${config.providerTokens.length ? config.providerTokens.map((provider) => provider.group || "default").join(", ") : dim("single")}`);
  console.log("");
  console.log("Wrappers:");
  for (const command of bridgeCommands) {
    const linkPath = path.join(localBinDir, command);
    let value = red("missing");
    try {
      const stat = fs.lstatSync(linkPath);
      if (stat.isSymbolicLink()) value = `${green("linked")} -> ${fs.readlinkSync(linkPath)}`;
      else value = yellow("exists, not bridge symlink");
    } catch {
      // missing
    }
    console.log(`  ${command.padEnd(13)} ${value}`);
  }
  console.log("");
  console.log("Upstream tools:");
  for (const [command, upstream] of Object.entries(launcherByCommand)) {
    const bin = executableOnPath(upstream);
    console.log(`  ${command.padEnd(13)} ${upstream.padEnd(9)} ${bin || red("not found")}`);
  }
}

async function models(args) {
  const config = loadBridgeConfig();
  const filter = (args[0] || "").toLowerCase();
  try {
    const allModels = await fetchModels(config);
    const shown = filter ? allModels.filter((model) => model.toLowerCase().includes(filter)) : allModels;
    for (const model of shown) console.log(model);
    if (shown.length === 0) console.log(dim("No matching models."));
  } catch (error) {
    fail(`could not fetch models from ${openAIChatBase(config.baseUrl)}/models: ${error.message}`);
  }
}

async function useModel(args) {
  const query = cleanModelId(args.join(" ").trim());
  if (!query) {
    console.log("Usage:");
    console.log("  zane use <model-id>");
    console.log("  zane model <model-id>");
    console.log("");
    console.log("Run 'zane models' to list available model ids.");
    return;
  }

  const config = loadBridgeConfig();
  let allModels = [];
  try {
    allModels = await fetchModels(config);
  } catch (error) {
    fail(`could not fetch models before changing default: ${error.message}`);
  }

  const exact = allModels.find((model) => model === query);
  const lowerQuery = query.toLowerCase();
  const matches = allModels.filter((model) => model.toLowerCase().includes(lowerQuery));
  const selected = exact || (matches.length === 1 ? matches[0] : "");

  if (!selected) {
    console.log(`Multiple or no models matched '${query}'.`);
    for (const model of matches.slice(0, 20)) console.log(model);
    if (matches.length > 20) console.log(dim(`... ${matches.length - 20} more`));
    console.log("");
    console.log("Use the exact model id, for example:");
    if (matches[0]) console.log(`  zane use ${matches[0]}`);
    process.exit(matches.length ? 2 : 1);
  }

  updateConfig({ model: selected });
  console.log(`Default ZaneLLM model set to ${green(selected)}.`);
  console.log("New wrapper sessions will use it. Existing CLI sessions keep their current model.");
}

async function doctor() {
  status();
  const config = loadBridgeConfig();
  console.log("");
  try {
    const allModels = await fetchModels(config);
    console.log(`${green("gateway models:")} ${allModels.length}`);
  } catch (error) {
    console.log(`${red("gateway models:")} ${error.message}`);
  }
}

function sanitizeUsageValue(value) {
  if (Array.isArray(value)) return value.map(sanitizeUsageValue);
  if (!value || typeof value !== "object") return value;
  const blocked = new Set(["api_key", "apikey", "key", "access_key", "secret", "password", "authorization"]);
  const out = {};
  for (const [key, item] of Object.entries(value)) {
    if (blocked.has(key.toLowerCase().replace(/-/g, "_"))) continue;
    out[key] = sanitizeUsageValue(item);
  }
  return out;
}

function unwrapData(value) {
  if (value && typeof value === "object" && Object.prototype.hasOwnProperty.call(value, "data")) {
    return value.data;
  }
  return value;
}

function numberField(record, keys) {
  if (!record || typeof record !== "object") return undefined;
  for (const key of keys) {
    const value = record[key];
    if (typeof value === "number" && Number.isFinite(value)) return value;
    if (typeof value === "string" && value.trim()) {
      const parsed = Number(value);
      if (Number.isFinite(parsed)) return parsed;
    }
  }
  return undefined;
}

function formatUsageNumber(value) {
  if (value === undefined || value === null || Number.isNaN(Number(value))) return dim("not reported");
  return new Intl.NumberFormat().format(Number(value));
}

async function fetchZaneUsageFromGateway(config) {
  const urls = [
    `${rootBaseUrl(config.baseUrl)}/api/v1/zane/usage`,
    "http://127.0.0.1:8080/api/v1/zane/usage",
    "http://localhost:8080/api/v1/zane/usage"
  ];
  let lastError;
  for (const url of Array.from(new Set(urls))) {
    try {
      return await fetchJsonChecked(url);
    } catch (error) {
      lastError = error;
    }
  }
  throw lastError || new Error("ZaneChat usage endpoint is unavailable");
}

async function fetchZaneUsageDirect(config) {
  const root = config.upstreamRootBaseUrl || newApiRootBase(config.upstreamBaseUrl);
  if (config.artemisiaAccessToken) {
    let profile = null;
    let tokens = null;
    let models = null;

    try {
      profile = sanitizeUsageValue(
        await newApiRequest(config.artemisiaAccessToken, config.newApiUserId, root, "GET", "/api/user/self")
      );
    } catch {
      profile = null;
    }

    try {
      tokens = listNewApiTokens(config.artemisiaAccessToken, config.newApiUserId, root)
        .then((items) => items.map(sanitizeUsageValue));
      tokens = await tokens;
    } catch {
      tokens = null;
    }

    try {
      models = sanitizeUsageValue(
        await newApiRequest(config.artemisiaAccessToken, config.newApiUserId, root, "GET", "/api/models")
      );
    } catch {
      models = null;
    }

    if (profile || tokens || models) {
      return {
        configured: true,
        account: {
          base_url: root,
          user_id: config.newApiUserId || null,
          profile_url: profile ? `${root}/api/user/self` : null,
          token_list_url: tokens ? `${root}/api/token/` : null,
          models_url: models ? `${root}/api/models` : null,
          profile,
          tokens,
          models
        }
      };
    }
  }

  const provider = config.providerTokens[0] || null;
  const providerKey = provider?.apiKey || (!config.artemisiaAccessToken ? config.apiKey : "");
  if (!providerKey) throw new Error("No artemisiahub access token or provider token is configured");

  const usageUrl = `${root}/api/usage/token`;
  const body = await fetchJsonChecked(usageUrl, {
    headers: {
      Authorization: `Bearer ${providerKey}`
    }
  });
  return {
    configured: true,
    provider: {
      provider: provider?.group || "artemisiahub",
      base_url: config.upstreamBaseUrl,
      usage_url: usageUrl,
      usage: sanitizeUsageValue(body)
    }
  };
}

function printUsage(payload) {
  const account = payload.account;
  const profile = unwrapData(account?.profile);
  const provider = payload.provider;
  const providerUsage = unwrapData(provider?.usage);
  const root = profile && typeof profile === "object" ? profile : providerUsage;

  console.log(`${cyan("Zane usage")}`);
  if (account) {
    console.log(`source:     artemisiahub profile`);
    if (profile && typeof profile === "object") {
      const username = profile.username || profile.display_name || profile.name || "";
      const email = profile.email || "";
      const userId = profile.id || account.user_id || "";
      if (username || email || userId) {
        console.log(`user:       ${[username, email && `<${email}>`, userId && `(id ${userId})`].filter(Boolean).join(" ")}`);
      }
      if (profile.group) console.log(`group:      ${profile.group}`);
    }
  } else if (provider) {
    console.log(`source:     ${provider.provider || "provider token"}`);
  }

  if (root && typeof root === "object") {
    console.log(`quota:      ${formatUsageNumber(numberField(root, ["quota", "total_granted", "granted_quota", "total_quota"]))}`);
    console.log(`used:       ${formatUsageNumber(numberField(root, ["used_quota", "total_used", "used", "quota_used"]))}`);
    console.log(`available:  ${formatUsageNumber(numberField(root, ["total_available", "available_quota", "remaining_quota", "remain_quota", "balance"]))}`);
    const requests = numberField(root, ["request_count", "requests", "total_requests"]);
    if (requests !== undefined) console.log(`requests:   ${formatUsageNumber(requests)}`);
    if (root.unlimited_quota !== undefined) console.log(`unlimited:  ${String(Boolean(root.unlimited_quota))}`);
  }

  if (Array.isArray(account?.tokens)) {
    console.log(`tokens:     ${account.tokens.length}`);
    for (const token of account.tokens.slice(0, 8)) {
      const name = token.name || token.token_name || token.id || "token";
      const group = token.group ? ` (${token.group})` : "";
      const remain = numberField(token, ["remain_quota", "total_available", "available_quota"]);
      console.log(`  ${String(name)}${group}: ${formatUsageNumber(remain)}`);
    }
    if (account.tokens.length > 8) console.log(dim(`  ... ${account.tokens.length - 8} more`));
  }
}

async function usage(args) {
  const config = loadBridgeConfig();
  let payload;
  try {
    payload = await fetchZaneUsageDirect(config);
  } catch (directError) {
    try {
      payload = await fetchZaneUsageFromGateway(config);
    } catch (gatewayError) {
      fail(`could not fetch usage: ${directError.message}; gateway fallback: ${gatewayError.message}`);
    }
  }

  if (args.includes("--json")) {
    console.log(JSON.stringify(sanitizeUsageValue(payload), null, 2));
    return;
  }

  if (!payload?.configured) {
    console.log(yellow(payload?.message || "Usage is not configured yet. Run zanecode once to set up artemisiahub."));
    return;
  }
  printUsage(payload);
}

