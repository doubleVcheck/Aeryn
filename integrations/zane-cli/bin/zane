  ensureDir(hermesHome);
  const hermesConfigFile = path.join(hermesHome, "config.yaml");
  const yaml = [
    "model:",
    `  default: "${config.model.replace(/"/g, '\\"')}"`,
    "  provider: custom",
    `  base_url: "${openAIChatBase(config.baseUrl).replace(/"/g, '\\"')}"`,
    "terminal:",
    '  cwd: "."',
    "display:",
    "  reasoning: off",
    "max_turns: 60",
    ""
  ].join("\n");
  fs.writeFileSync(hermesConfigFile, yaml, { mode: 0o600 });
}

