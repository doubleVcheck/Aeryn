async function main() {
  const invoked = path.basename(process.argv[1] || "zane");
  const args = process.argv.slice(2);

  if (invoked === "zanei") {
    install(args);
    return;
  }

  if (invoked === "zaned" || invoked === "zanedisable") {
    restore(args);
    return;
  }

  if (invoked === "zaneupdate") {
    await updateModelCatalog(args);
    return;
  }

  if (launcherByCommand[invoked]) {
    switch (invoked) {
      case "zanechat":
        await launchZaneChat(args);
        return;
      case "zanecc":
        launchClaude(args);
        return;
      case "zanecli":
        await launchzanecode(args, "zanecli");
        return;
      case "zanecode":
        await launchzanecode(args, "zanecode");
        return;
      case "zaneapp":
        await launchZaneApp(args);
        return;
      case "zanegpt":
      case "zanecodex":
        await launchCodex(args);
        return;
      case "zanegrok":
      case "zanexai":
        await launchGrok(args);
        return;
      case "zanegrokcli":
        await launchGrokCli(args);
        return;
      case "zaneoc":
      case "zaneopencode":
        await launchCompatCli(args);
        return;
      case "zanea":
      case "zaneaider":
        launchAider(args);
        return;
      case "zanecontinue":
      case "zanecn":
        await launchContinue(args);
        return;
      case "zaneh":
      case "zanehermes":
        launchHermes(args);
        return;
      case "zanegoose":
        launchGoose(args);
        return;
      case "zanegemini":
        unsupportedGemini();
        return;
      case "zanecursor":
        unsupportedCursor();
        return;
    }
  }

  const command = args.shift();
  switch (command) {
    case undefined:
    case "":
    case "help":
    case "--help":
    case "-h":
      help();
      break;
    case "install":
    case "i":
      install(args);
      break;
    case "setup":
    case "bootstrap":
      await setup(args);
      break;
    case "update":
    case "refresh":
    case "sync":
      await updateModelCatalog(args);
      break;
    case "chat":
    case "zanechat":
      await launchZaneChat(args);
      break;
    case "restore":
    case "disable":
    case "d":
      restore(args);
      break;
    case "delete":
    case "del":
    case "rm":
      restore(["--remove-manager", ...args]);
      break;
    case "apps":
    case "endpoints":
      apps();
      break;
    case "status":
      status();
      break;
    case "usage":
    case "useage":
      await usage(args);
      break;
    case "models":
      await models(args);
      break;
    case "use":
    case "model":
    case "m":
      await useModel(args);
      break;
    case "doctor":
      await doctor();
      break;
    case "cc":
    case "claude":
      launchClaude(args);
      break;
    case "cli":
    case "zanecli":
      await launchzanecode(args, "zanecli");
      break;
    case "code":
    case "zanecode":
      await launchzanecode(args, "zanecode");
      break;
    case "app":
    case "zaneapp":
      await launchZaneApp(args);
      break;
    case "codex":
    case "gpt":
      await launchCodex(args);
      break;
    case "grok":
    case "xai":
      await launchGrok(args);
      break;
    case "grokcli":
      await launchGrokCli(args);
      break;
    case "opencode":
    case "oc":
      await launchCompatCli(args);
      break;
    case "aider":
    case "a":
      launchAider(args);
      break;
    case "continue":
    case "cn":
      await launchContinue(args);
      break;
    case "hermes":
    case "h":
      launchHermes(args);
      break;
    case "goose":
      launchGoose(args);
      break;
    case "gemini":
      unsupportedGemini();
      break;
    case "cursor":
      unsupportedCursor();
      break;
    default:
      fail(`unknown command '${command}'. Run 'zane --help'.`);
  }
}

main().catch((error) => fail(error?.message || String(error)));
